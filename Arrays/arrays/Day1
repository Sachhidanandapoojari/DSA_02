#Quick sort
class QuickSort:
    def partition(self,num,l,r):
        #write the swapping tech
        start=l
        key=num[r]       
        for i in range(l,r+1):
            if num[i]<=key:
                temp=num[i]
                num[i]=num[start]
                num[start]=temp
                start+=1
        return start-1         
        
    def quickSort(self,num,l,r):
        if l>=r:
            return
        p=self.partition(num,l,r)
        
        self.quickSort(num,l,p-1)
        self.quickSort(num,p+1,r)

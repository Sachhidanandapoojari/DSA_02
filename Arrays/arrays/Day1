def selection_sorting(num):
    n=len(num)
    for i in range(n-1):
        min_idx=i
        for j in range(i+1,n):
            if num[j]<num[min_idx]:
                min_idx=j
        temp=num[min_idx]
        num[min_idx]=num[i]
        num[i]=temp
    return num
    



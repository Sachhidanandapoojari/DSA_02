    col=len(matrix[0])
    if matrix[r][c]==0:
        for j in range(0,col):
            if matrix[r][j]!=0:
                matrix[r][j]=float('inf')
        for i in range(0,row):
            if matrix[i][c]!=0:
                matrix[i][c]=float('inf')
        
        for i in range(0,row):
            for j in range(0,col):
                if matrix[i][j]==float('inf'):
                    matrix[i][j]=0
                            
    return matrix
